<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.glslplayground.app"
    android:versionCode="20"
    android:versionName="1.2">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="28" />

    <!-- 电源键那条路要能用 root（su）直接起前台服务：服务必须 exported，
         再用一个 signature 级权限把别的 App 挡在外面（root/系统不受限）。 -->
    <permission
        android:name="com.glslplayground.app.permission.BALL"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.glslplayground.app.permission.BALL" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 网络只用于 127.0.0.1 的 DSH HTTP API -->
    <!-- 调试覆盖层开关：写 pointer_location / show_touches（开发者选项里那两个） -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 初始状态的"语音转文字"：16 kHz PCM16 采集，交给本机 DSH 的 speech/transcribe -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 音量减键 = 收麦发送：那一下按键会把媒体音量按下去一格，收尾后调回原值 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 设置 = DSH 自己的设置界面（WebView 指向本机 DSH 前端） -->
        <activity
            android:name=".DshSettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 实验：聊天页 = DSH 前端网页本身（全屏 WebView，签名 cookie 复用 RPC 那一份） -->
        <activity
            android:name=".WebChatActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:windowSoftInputMode="adjustResize" />

        <!-- 无界面跳板：root 起它 → 它在 Activity 上下文里起前台服务（绕开后台启动限制） -->
        <activity
            android:name=".PowerBallTrampolineActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleTop" />

        <!-- 「添附件」的系统文件选择器壳子：透明、不驻留、不进最近任务 -->
        <activity
            android:name=".BallAttachPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 空壳无障碍服务：只为拿到 TYPE_ACCESSIBILITY_OVERLAY 的资格（见 BallA11yService） -->
        <service
            android:name=".BallA11yService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ball_a11y" />
        </service>

        <service
            android:name=".FloatingBallService"
            android:exported="true"
            android:permission="com.glslplayground.app.permission.BALL"
            android:foregroundServiceType="mediaProjection" />

        <!-- 长按电源键 → 悬浮于桌面。SystemUI 的 LSPosed 钩子（com.pj.powerkey）吞掉
             电源菜单后给这里发广播；也能用 am broadcast 手动触发（见 docs/POWERKEY.md）。 -->
        <receiver
            android:name=".PowerBallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.glslplayground.app.action.POWER_BALL" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
