#!/system/bin/sh
# 球触摸门控：所有 input 注入（插件、shell、任何自动化）都先让球把触摸区挪开，注入完还原。
# 调试关闭：touch /data/local/tmp/ball-gate-off
D=/data/local/tmp
APP=/sdcard/Android/data/com.glslplayground.app/files
if [ -e "$D/ball-gate-off" ]; then exec cmd input "$@"; fi
pidof com.glslplayground.app >/dev/null 2>&1 || exec cmd input "$@"   # 球没在跑：直接放行
N="sh-$(date +%s%N)-$$"
printf "%s\n" "$N" > "$D/.ball-act.tmp" 2>/dev/null && mv "$D/.ball-act.tmp" "$D/dsh-ball-act" 2>/dev/null
i=0
while [ $i -lt 10 ]; do
  A=$(cat "$APP/dsh-ball-ack" 2>/dev/null)
  [ "$A" = "$N" ] && break
  sleep 0.02
  i=$((i+1))
done
if [ $i -ge 10 ]; then sleep 0.05; else sleep 0.04; fi
cmd input "$@"
rc=$?
printf "%s\n" "$N" > "$D/.ball-done.tmp" 2>/dev/null && mv "$D/.ball-done.tmp" "$D/dsh-ball-done" 2>/dev/null
exit $rc
